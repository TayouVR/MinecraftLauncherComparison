---
import { columnClass } from "../../data/utils.ts";

// Row for the "technology" property: two sub-rows (languages, frameworks).
// Each value is a Technology { languages: string[], frameworks: string[] }.
const { launchers, values } = Astro.props as {
	launchers: LauncherDetails[];
	values: { identifier: string; value: Technology }[];
};

const valueFor = (l: LauncherDetails) => values.find(v => v.identifier === l.identifier)?.value;
---
<tr>
	<td>Languages</td>
	{ launchers.map(launcher => (
		<td class:list={columnClass(launcher)}>
			{valueFor(launcher).languages.join(', ')}
		</td>
	))}
</tr>
<tr>
	<td>Core Toolkits and Libraries</td>
	{ launchers.map(launcher => (
		<td class:list={columnClass(launcher)}>
			{valueFor(launcher).frameworks.join(', ')}
		</td>
	))}
</tr>
