---
import PlatformComponent from "./PlatformComponent.astro";
import ModloadersComponent from "./ModloadersComponent.astro";
import MinecraftResources from "./MinecraftResources.astro";
import ModpacksComponent from "./ModpacksComponent.astro";
import TechnologyRow from "./rows/TechnologyRow.astro";
import JavaRow from "./rows/JavaRow.astro";
import StatusInfoRow from "./rows/StatusInfoRow.astro";
import ImportExportRow from "./rows/ImportExportRow.astro";
import { columnClass } from "../data/utils.ts";

const { propertyName, launchers, propCategory } = Astro.props as { propertyName: string, launchers: LauncherDetails[], propCategory: "properties" | "features" };

function valueFromLauncher<TLauncher extends Record<"properties" | "features", Record<string, any>>>(launcher: LauncherDetails) {
    return (launcher as any as TLauncher)[propCategory][propertyName];
}

// Fallback renderer for feature/property values without a dedicated row.
// Converts the raw value to display text.
function fallbackText(value: unknown): string {
    if (typeof value === "string") return value.toUpperCase();
    if (typeof value === "number") return value.toFixed(2);
    if (Array.isArray(value)) return value.join(', ');
    return "Unsupported Type";
}

const values = launchers.map(launcher => {
    return {
        identifier: launcher.identifier,
        value: valueFromLauncher(launcher)
    }
});

const ROW_COMPONENTS: Record<string, any> = {
    "platforms": PlatformComponent,
    "technology": TechnologyRow,
    "modpacks": ModpacksComponent,
    "modloaders": ModloadersComponent,
    "minecraftResources": MinecraftResources,
    "java": JavaRow,
    "sandboxing": StatusInfoRow,
    "overlay": StatusInfoRow,
    "advertisements": StatusInfoRow,
    "telemetry": StatusInfoRow,
    "import": ImportExportRow,
    "export": ImportExportRow,
};
const Row = ROW_COMPONENTS[propertyName];

if (!Row) {
    console.warn("property doesn't have dedicated row rendering", propertyName);
}

---

{Row ? (
    <Row launchers={launchers} values={values} propertyName={propertyName} />
) : (
    <tr>
        <td class="capitalize">{propertyName}</td>
        { launchers.map(launcher => (
            <td class:list={columnClass(launcher)}>
                {fallbackText(valueFromLauncher(launcher))}
            </td>
        ))}
    </tr>
)}
