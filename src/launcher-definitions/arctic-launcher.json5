{
  "identifier": "com.arcticlauncher.launcher",
  "name": "Arctic Launcher",
  "icon": "/assets/launchers/arctic-launcher.png",
  "downloadLink": "https://arcticlauncher.com/download",
  "sourceRepo": "https://github.com/brksfrb/arctic-launcher",
  "homepage": "https://arcticlauncher.com/",
  "configuration": {
    "license": {
      "name": "GPL-3.0-or-later",
      "url": "https://github.com/brksfrb/arctic-launcher/blob/main/LICENSE",
      "foss": true,
      "extraInfo": ""
    },
    "serverInstances": false,
    "lookAndFeel": "Custom"
  },
  "features": {
    "offlinePlayWithoutLicense": true,
    "bundledMod": {
      "short": "Arctic Client: in-game cosmetics, friends & join system, voice, replay, HUD",
      "long": "Bundles the 'Arctic Client' mod (open source, GPL-3.0, Java sources in the same repo under mod/). It adds cosmetics & emotes, a friends / join-together system, proximity voice chat, a replay recorder, PvP 'tiers' display and a custom HUD. It talks to Arctic's closed-source first-party backend (cosmetics.arcticlauncher.com) for the social features."
    },
    "modpacks": [
      { "name": "Modrinth", "method": "Download", "updating": false }
    ],
    "modloaders": ["forge", "neoforge", "fabric", "quilt"],
    "minecraftResources": {
      "mods": {
        "downloading": true,
        "providers": ["Modrinth"]
      },
      "resourcepacks": {
        "downloading": true,
        "providers": ["Modrinth"]
      },
      "shaderpacks": {
        "downloading": true,
        "providers": ["Modrinth"]
      },
      "worlds": {
        "downloading": false,
        "providers": []
      },
      "datapacks": {
        "downloading": false,
        "providers": []
      },
      "plugins": {
        "downloading": false,
        "providers": []
      }
    },
    "import": ["Vanilla Launcher", "OneSix", "Modrinth", "CurseForge", "ATLauncher", "GDLauncher", "TLauncher", "Lunar Client", "Badlion Client", "Feather Client", "LabyMod"],
    "export": ["Arctic share code"],
    "java": {
      "download": true,
      "versionManagement": true,
      "usingSystemInstall": true
    },
    "sandboxing": { "status": "" },
    // Overlay provided by the bundled Arctic Client mod (HUD), not the launcher itself.
    "overlay": { "status": "" },
    // No ad networks/analytics, but has a dismissible first-party sponsor card (Flash Hosting).
    "advertisements": { "status": "No", "note": "No ads/analytics; has a dismissible first-party sponsor card (Flash Hosting)" }
  },
  "properties": {
    "platforms": {
      "linux": ["x86_64"],
      "windows": ["x86_64"],
      "macos": ["x86_64", "arm64"]
    },
    "packages": "",
    "technology": {
      "languages": ["Rust", "Java"],
      "frameworks": ["egui"]
    }
  },
  "specialFeatures": {
    "CurseForgeBlockedDownloads": {
      "supported": false,
      "method": ""
    }
  }
}
