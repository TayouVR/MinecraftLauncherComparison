---
import Layout from '../layouts/Layout.astro';

import json5 from 'json5';
import { readFileSync, readdirSync } from 'fs';
import path from 'path';
import ListComponent from "../components/ListComponent.astro";
import { columnClass } from "../data/utils.ts";

function getLauncherDetails(path: string) {
	return json5.parse<LauncherDetails>(
		readFileSync(path, 'utf-8')
	);
}


const dataDir = './src/launcher-definitions'; // Define the directory that holds JSON5 files
const launchers: LauncherDetails[] = [];

// Dynamically loop through all files in the directory
readdirSync(dataDir).forEach((file) => {
	if (file.endsWith('.json5')) {
		const filePath = path.join(dataDir, file); // Construct full file path
		launchers.push(getLauncherDetails(filePath)); // Parse and push to `launchers`
	}
});

function launcherProperties<TLauncher extends Record<string, any>>(
	launchers: LauncherDetails[],
	sections: (keyof TLauncher)[]
): Array<{ name: string; values: Array<{ identifier: string; value: unknown }>; }> {
	// Create a map to group properties by name
	const grouped: Record<string, { name: string; values: Array<{ identifier: string; value: unknown }>; }> = {};

	// Iterate over each launcher
	(launchers as any as TLauncher[]).forEach((launcher) => {
		sections.forEach((section) => {
			// console.log(`\nSection: ${String(section)}`);
			const fields = launcher[section];

			Object.entries(fields).forEach(([fieldName, fieldValue]) => {
				// console.log(`Field Name: ${fieldName}`);
				// console.log("Field Value:", fieldValue);
				if (!grouped[fieldName]) {
					// If the `name` doesn't exist in the grouped map, initialize it
					grouped[fieldName] = { name: fieldName, values: [] };
				}
				// Add the launcher identifier and its property value
				grouped[fieldName].values.push({
					identifier: launcher.identifier,
					value: fieldValue,
				});
			});
		});
	});

 // Convert the grouped entries back into an array
	return Object.values(grouped);
}

const hasBundledMod = launchers.some(l => l.features.bundledMod);
// Columns of piracy-facilitating launchers are tinted brown, so note it up top.
const piracyCount = launchers.filter(l => l.features.offlinePlayWithoutLicense).length;
---

<Layout>
	<section class="container sticky left-0 mx-auto max-w-3xl p-4">
		<h2 class="text-center text-xl font-semibold">
			This will give you an overview over the various Minecraft (Java Edition) launchers and their features.
		</h2>

		<div class="mt-6 space-y-4">
			<div>
				<strong class="block mb-1">Explanations</strong>
				<ul class="list-disc space-y-2 pl-6">
					<li><strong>Modloader support</strong> means a way to install the modloader through the launcher directly, without downloading it separately.</li>
					<li><strong>CurseForge blocked downloads:</strong> CurseForge offers creators on the platform the option to opt out of downloads from 3rd party platforms as a means to ensure ad revenue is generated when downloading content. Platforms need to work around that restriction to properly support CurseForge content.</li>
				</ul>
			</div>

			{piracyCount > 0 && (
				<div>
					<strong class="block mb-1">Color coding</strong>
					<p>
						<span class="inline-block h-3 w-3 rounded-sm align-[-1px] piracy-swatch"></span>
						<strong>Brown</strong> marks launchers that allow full-game play without owning a Minecraft license
						(offline accounts, no demo mode). This facilitates piracy. {piracyCount === 1 ? "It is" : "They are"} hidden by default; enable {piracyCount === 1 ? "it" : "them"} via the <em>Filter Launchers</em> menu.
					</p>
				</div>
			)}

			<div>
				<strong class="block mb-1">Note</strong>
				<p>
					This list is maintained mostly by me and random contributions. Data will inevitably get outdated over time and I always welcome any updates and corrections. See the GitHub linked in the header.
				</p>
				<p class="mt-2">
					Listed launchers are generally probed for obvious malware, but this is no guarantee. Please evaluate each launcher yourself based on its popularity and general community trust before using it.
				</p>
			</div>
		</div>
	</section>

	<div class="sticky top-0 table-container w-screen overflow-y-visible">
	<table class="sticky top-0 table table-zebra table-hover table-bordered w-full border-separate border-spacing-0 comparison">
		<thead class="sticky top-16 z-10 bg-base-100 shadow-sm">
			<tr class="header-row">
				<th class="bg-base-100">Feature</th>
				{ launchers.map(launcher => (
					<th class:list={columnClass(launcher, "bg-base-100")}>
						<a href={`/launcher/${launcher.identifier}`} class="flex flex-col items-center gap-2 hover:bg-base-200 p-2 rounded-lg transition-colors h-full w-full justify-center">
							{ launcher.icon ? (
								<img class="launcher-icon w-16 h-16 object-contain" src={launcher.icon}  alt=`${launcher.name} Icon` />
							) : <div class="w-16 h-16 flex items-center justify-center font-bold">?</div>}
							<span class="text-center">{launcher.name}</span>
						</a>
					</th>
				))}
			</tr>
		</thead>
		<tbody>
			<tr>
				<td>License</td>
				{ launchers.map(launcher => (
					<td class:list={columnClass(launcher)}>
						<div class:list={[launcher.identifier, launcher.configuration.license.foss ? "yes" : "no", "badge"]}>
							{launcher.configuration.license.name}
						</div>
					</td>
				))}
			</tr>
			<tr>
				<td>Look & Feel</td>
				{ launchers.map(launcher => (
					<td class:list={columnClass(launcher)}>{launcher.configuration.lookAndFeel}</td>
				))}
			</tr>
			{ launcherProperties(launchers, ["properties"])
				.filter((prop) => prop.name != "packages")
				.map((property) => (
				<ListComponent propertyName={property.name} launchers={launchers} propCategory="properties" />
			))}
			{ launcherProperties(launchers, ["features"])
				// bundledMod has its own row below; offlinePlayWithoutLicense is shown as "Allows Piracy".
				.filter((prop) => prop.name !== "bundledMod" && prop.name !== "offlinePlayWithoutLicense")
				.map((property) => (
				<ListComponent propertyName={property.name} launchers={launchers} propCategory="features" />
			))}
            <tr>
                <td>Allows Piracy</td>
                { launchers.map(launcher => {
					const flag = launcher.features.offlinePlayWithoutLicense;
					return (
					<td class:list={columnClass(launcher)}>
						{flag === true ? (
							<div class="badge h-fit no">Yes</div>
						) : flag === false ? (
							<div class="badge h-fit yes">No</div>
						) : (
							<div class="badge h-fit bg-accent-content/10"></div>
						)}
					</td>
					);
                })}
            </tr>
            <tr>
                <td>CurseForge Blocked Mods handling</td>
                { launchers.map(launcher => {
					const cf = launcher.specialFeatures.CurseForgeBlockedDownloads;
					const tone = cf.supported ? (cf.legallyGray ? "shady" : "yes") : "no";
					return (
					<td class:list={columnClass(launcher)}>
						<div class:list={["badge h-fit bg-accent-content/10", tone, cf.legallyGray && "tooltip tooltip-bottom"]} data-tip={cf.note}>
							{cf.method != "" ? cf.method : "No"}
							{cf.legallyGray && <span class="ml-1" title={cf.note}>⚠️</span>}
						</div>
					</td>
					);
                })}
            </tr>
            {hasBundledMod && (
            <tr>
                <td>Bundled Client Mod</td>
                { launchers.map(launcher => (
					<td class:list={columnClass(launcher)}>
						{launcher.features.bundledMod ? (
							<div class="badge h-fit bundled-mod-badge tooltip tooltip-bottom whitespace-normal text-left" data-tip={launcher.features.bundledMod.long ?? launcher.features.bundledMod.short}>
								{launcher.features.bundledMod.short}
							</div>
						) : (
							<div class="badge h-fit no">No</div>
						)}
					</td>
                ))}
            </tr>
            )}
		</tbody>
	</table>
	</div>
</Layout>